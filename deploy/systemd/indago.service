[Unit]
Description=Indago authorized web security scanner
Documentation=https://github.com/xcupi/indago/blob/main/docs/deployment.md
After=network.target

[Service]
Type=simple
User=indago
Group=indago
StateDirectory=indago
StateDirectoryMode=0750
CacheDirectory=indago
CacheDirectoryMode=0750
RuntimeDirectory=indago
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/indago
EnvironmentFile=/etc/indago/indago.env
Environment=HOME=/var/cache/indago
Environment=XDG_CACHE_HOME=/var/cache/indago
ExecStart=/usr/local/bin/indago serve -data /var/lib/indago -addr 127.0.0.1:8750
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# State/Cache/RuntimeDirectory remain writable under ProtectSystem=strict.
# Do not add MemoryDenyWriteExecute or blanket namespace/syscall restrictions:
# the optional real Chromium driver needs JIT and process/namespace support.

[Install]
WantedBy=multi-user.target
