# Install as /etc/indago/indago.env, root:root, chmod 600.
# Provision a fresh >=32-character random token here using your secret manager.
# No example/live token is supplied. Do not put tokens in ExecStart/config.json.
# Blank is deliberately loopback-only unauthenticated mode, NOT a provisioned
# production credential. Set this before placing a local TLS proxy in front.
INDAGO_API_TOKEN=
# Optional AI/password-login secrets are also environment-only; omit unless used.
# Browser paths live in the optional browser.conf drop-in, not secret values.
